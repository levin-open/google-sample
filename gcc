Q18. Binary search on a sorted array
File: binary.c
#include <stdio.h>

int main() {
    int a[100], n, key, i;
    int low, high, mid, found = 0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n < 1 || n > 100)
        return 0;

    printf("Enter sorted elements: ");
    for (i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter search element: ");
    scanf("%d", &key);

    low = 0;
    high = n - 1;

    while (low <= high) {
        mid = low + (high - low) / 2;

        if (a[mid] == key) {
            printf("Found at position %d\n", mid + 1);
            found = 1;
            break;
        } else if (a[mid] < key) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }

    if (!found)
        printf("Element not found\n");

    return 0;
}


Commands:
nano binary.c
gcc binary.c -o binary
./binary


Remember: Binary search requires the array to be sorted.
Q19. Implement a stack using an array
File: stack.c

A stack follows LIFO — Last In, First Out.
#include <stdio.h>
#define MAX 5

int main() {
    int s[MAX], top = -1, choice, x, i;

    while (1) {
        printf("\n1.Push  2.Pop  3.Display  4.Exit\n");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                if (top == MAX - 1)
                    printf("Stack Overflow\n");
                else {
                    printf("Enter element: ");
                    scanf("%d", &x);
                    s[++top] = x;
                }
                break;

            case 2:
                if (top == -1)
                    printf("Stack Underflow\n");
                else
                    printf("Popped = %d\n", s[top--]);
                break;

            case 3:
                if (top == -1)
                    printf("Stack is empty\n");
                else {
                    for (i = top; i >= 0; i--)
                        printf("%d ", s[i]);
                    printf("\n");
                }
                break;

            case 4:
                return 0;

            default:
                printf("Invalid choice\n");
        }
    }
}


Commands:
nano stack.c
gcc stack.c -o stack
./stack


Q20. Implement a queue using an array
File: queue.c

A queue follows FIFO — First In, First Out.
#include <stdio.h>
#define MAX 5

int main() {
    int q[MAX], front = 0, rear = -1;
    int choice, x, i;

    while (1) {
        printf("\n1.Enqueue  2.Dequeue  3.Display  4.Exit\n");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                if (rear == MAX - 1)
                    printf("Queue Overflow\n");
                else {
                    printf("Enter element: ");
                    scanf("%d", &x);
                    q[++rear] = x;
                }
                break;

            case 2:
                if (front > rear)
                    printf("Queue Underflow\n");
                else
                    printf("Deleted = %d\n", q[front++]);
                break;

            case 3:
                if (front > rear)
                    printf("Queue is empty\n");
                else {
                    for (i = front; i <= rear; i++)
                        printf("%d ", q[i]);
                    printf("\n");
                }
                break;

            case 4:
                return 0;

            default:
                printf("Invalid choice\n");
        }
    }
}


Commands:
nano queue.c
gcc queue.c -o queue
./queue


This is a simple linear queue. Once its rear reaches the end, it cannot accept further elements even if earlier positions are free.
