Q8. Factorial of a number
File: factorial.c
#include <stdio.h>

int main() {
    int n, i;
    long long fact = 1;

    printf("Enter a number: ");
    scanf("%d", &n);

    if (n < 0) {
        printf("Factorial is not defined for negative numbers.\n");
        return 0;
    }

    for (i = 1; i <= n; i++)
        fact *= i;

    printf("Factorial = %lld\n", fact);
    return 0;
}


Commands:
nano factorial.c
gcc factorial.c -o factorial
./factorial


Q9. Check whether a number is prime
File: prime.c
#include <stdio.h>

int main() {
    int n, i, prime = 1;

    printf("Enter a number: ");
    scanf("%d", &n);

    if (n < 2)
        prime = 0;

    for (i = 2; i <= n / i; i++) {
        if (n % i == 0) {
            prime = 0;
            break;
        }
    }

    if (prime)
        printf("Prime number\n");
    else
        printf("Not a prime number\n");

    return 0;
}


