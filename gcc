#include <stdio.h>
#include <stdlib.h>

int main() {
    int a, b, r;

    printf("Enter two integers: ");
    scanf("%d%d", &a, &b);

    a = abs(a);
    b = abs(b);

    while (b != 0) {
        r = a % b;
        a = b;
        b = r;
    }

