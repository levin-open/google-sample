Q22. Singly linked list — insertion and display
File: linkedlist.c
#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *next;
};

int main() {
    struct Node *head = NULL, *temp, *newnode;
    int choice, x;

    while (1) {
        printf("\n1.Insert  2.Display  3.Exit\n");
        scanf("%d", &choice);

        if (choice == 1) {
            newnode = malloc(sizeof(struct Node));

            if (newnode == NULL) {
                printf("Memory allocation failed\n");
                return 1;
            }

            printf("Enter data: ");
            scanf("%d", &x);

            newnode->data = x;
            newnode->next = NULL;

            if (head == NULL) {
                head = newnode;
            } else {
                temp = head;
                while (temp->next != NULL)
                    temp = temp->next;

                temp->next = newnode;
            }

        } else if (choice == 2) {
            temp = head;

            while (temp != NULL) {
                printf("%d -> ", temp->data);
                temp = temp->next;
            }

            printf("NULL\n");

        } else if (choice == 3) {
            while (head != NULL) {
                temp = head;
                head = head->next;
                free(temp);
            }
            return 0;

        } else {
            printf("Invalid choice\n");
        }
    }
}


Commands:
nano linkedlist.c
gcc linkedlist.c -o linkedlist
./linkedlist


Remember: Create a node → store data → connect it using next → traverse until NULL to display.
Q23. Binary search tree — insertion and traversal
File: bst.c

This program inserts numbers into a BST and displays the inorder traversal, which prints the values in ascending order.
#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *left, *right;
};

struct Node *insert(struct Node *root, int x) {
    if (root == NULL) {
        struct Node *newnode = malloc(sizeof(struct Node));

        if (newnode == NULL) {
            printf("Memory allocation failed\n");
            exit(1);
        }

        newnode->data = x;
        newnode->left = newnode->right = NULL;
        return newnode;
    }

    if (x < root->data)
        root->left = insert(root->left, x);
    else if (x > root->data)
        root->right = insert(root->right, x);

    return root;
}

void inorder(struct Node *root) {
    if (root != NULL) {
        inorder(root->left);
        printf("%d ", root->data);
        inorder(root->right);
    }
}

void freeTree(struct Node *root) {
    if (root != NULL) {
        freeTree(root->left);
        freeTree(root->right);
        free(root);
    }
}

int main() {
    struct Node *root = NULL;
    int n, x, i;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n < 0)
        return 0;

    for (i = 0; i < n; i++) {
        printf("Enter element: ");
        scanf("%d", &x);
        root = insert(root, x);
    }

    printf("Inorder traversal: ");
    inorder(root);
    printf("\n");

    freeTree(root);
    return 0;
}


Commands:
nano bst.c
gcc bst.c -o bst
./bst


Remember: Smaller values go left, larger values go right. Inorder means Left → Root → Right.

