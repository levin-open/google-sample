Q25 (Original Q11) — Personalized greeting

Save this program as main.py. For the next question, replace main.py with that question's code.

from urllib.parse import parse_qs
from html import escape

def app(environ, start_response):
    if environ['REQUEST_METHOD'] == 'POST':
        size = int(environ.get('CONTENT_LENGTH') or 0)
        data = parse_qs(environ['wsgi.input'].read(size).decode('utf-8'))
        name = escape(data.get('name', ['Guest'])[0])
        body = f'<h1>Hello, {name}!</h1><a href="/">Back</a>'
    else:
        body = (
            '<h2>Enter Your Name</h2>'
            '<form method="post">'
            '<input name="name" required>'
            '<button type="submit">Submit</button></form>'
        )
    start_response('200 OK', [('Content-Type', 'text/html; charset=utf-8')])
    return [body.encode('utf-8')]

