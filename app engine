def app(environ, start_response):
    path = environ.get('PATH_INFO', '/')
    pages = {
        '/': ('<h1>Welcome to My Website</h1>'
              '<a href="/about">About</a><br>'
              '<a href="/services">Services</a><br>'
              '<a href="/contact">Contact</a>'),
        '/about': '<h2>About Us</h2><a href="/">Home</a>',
        '/services': '<h2>Our Services</h2><a href="/">Home</a>',
        '/contact': '<h2>Contact Us</h2><a href="/">Home</a>'
    }
    if path in pages:
        status, body = '200 OK', pages[path]
    else:
        status, body = '404 Not Found', '<h2>Page Not Found</h2><a href="/">Home</a>'
    start_response(status, [('Content-Type', 'text/html; charset=utf-8')])
    return [body.encode('utf-8')]

